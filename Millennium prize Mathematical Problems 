def computational_complexity_udvt(n_bits, beta):
    # Classical Exponential Time
    t_classical = 2**n_bits
    # UDVT Non-local reduction
    # Complexity collapses as beta increases
    t_udvt = n_bits**(k / (1 + beta)) # where k is a constant
    return t_classical, t_udvt

