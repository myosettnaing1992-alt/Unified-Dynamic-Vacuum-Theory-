def elliptic_curve_rank_udvt(phi_field):
    # Mapping Vacuum Topology to BSD Rank
    # Rank is proportional to the winding number of the vacuum field
    winding_number = np.sum(np.abs(np.diff(np.sign(np.gradient(phi_field))))) / 2
    return int(winding_number)

